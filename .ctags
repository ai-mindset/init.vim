
--langdef=Elixir
--langmap=Elixir:.ex,.exs
--regex-Elixir=/^[ \t]*def(p?)[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\2/f,functions/
--regex-Elixir=/^[ \t]*defmacro(p?)[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\2/a,macros/
--regex-Elixir=/^[ \t]*defmodule[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/m,modules/
--regex-Elixir=/^[ \t]*defprotocol[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/p,protocols/
--regex-Elixir=/^[ \t]*defimpl[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/i,implementations/
--regex-Elixir=/^[ \t]*defexception[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/e,exceptions/
--regex-Elixir=/^[ \t]*defdelegate[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\1/d,delegates/
--regex-Elixir=/^[ \t]*defrecord[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/r,records/
--regex-Elixir=/^[ \t]*test[ \t]+"([^"]*)"/\1/t,tests/
--regex-Elixir=/^[ \t]*@callback[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\1/c,callbacks/
--regex-Elixir=/^[ \t]*defoperator[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/o,operators/

--langdef=Zig
--langmap=Zig:.zig
--regex-Zig=/^[ \t]*(export[ \t]+|pub[ \t]+|inline[ \t]+)*fn[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f,functions/
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*struct/\2/s,structs/
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*enum/\2/e,enums/
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*union/\2/u,unions/
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/c,constants/
--regex-Zig=/^[ \t]*(pub[ \t]+)?var[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/v,variables/
--regex-Zig=/^[ \t]*test[ \t]+"([^"]*)"/\1/t,tests/

--langdef=JavaScript
--langmap=JavaScript:.js,.jsm,.mjs,.cjs,.jsx
--regex-JavaScript=/^[ \t]*function[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/f,functions/
--regex-JavaScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*function/\2/f,functions/
--regex-JavaScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*\([^)]*\)[ \t]*=>/\2/f,functions/
--regex-JavaScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*async[ \t]*function/\2/f,functions/
--regex-JavaScript=/^[ \t]*class[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/c,classes/
--regex-JavaScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*class/\2/c,classes/
--regex-JavaScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/v,variables/

--langdef=TypeScript
--langmap=TypeScript:.ts,.tsx,.mts,.cts
--regex-TypeScript=/^[ \t]*function[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/f,functions/
--regex-TypeScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*function/\2/f,functions/
--regex-TypeScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*\([^)]*\)[ \t]*=>/\2/f,functions/
--regex-TypeScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=[ \t]*async[ \t]*function/\2/f,functions/
--regex-TypeScript=/^[ \t]*(export[ \t]+)?(default[ \t]+)?(async[ \t]+)?function[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\4/f,functions/
--regex-TypeScript=/^[ \t]*class[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/c,classes/
--regex-TypeScript=/^[ \t]*(export[ \t]+)?(default[ \t]+)?class[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\3/c,classes/
--regex-TypeScript=/^[ \t]*interface[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/i,interfaces/
--regex-TypeScript=/^[ \t]*type[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*=/\1/t,types/
--regex-TypeScript=/^[ \t]*enum[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/e,enums/
--regex-TypeScript=/^[ \t]*(const|let|var)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/v,variables/
