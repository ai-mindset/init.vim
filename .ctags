# Keep the custom Elixir rules separate from Universal Ctags' built-in parser.
--langdef=ElixirCustom
--langmap=ElixirCustom:.ex.exs
--regex-ElixirCustom=/^[ \t]*def(p?)[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\2/f,functions/
--regex-ElixirCustom=/^[ \t]*defmacro(p?)[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\2/a,macros/
--regex-ElixirCustom=/^[ \t]*defmodule[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/m,modules/
--regex-ElixirCustom=/^[ \t]*defprotocol[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/p,protocols/
--regex-ElixirCustom=/^[ \t]*defimpl[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/i,implementations/
--regex-ElixirCustom=/^[ \t]*defexception[ \t]+([A-Z][a-zA-Z0-9_.]*)/\1/e,exceptions/
--regex-ElixirCustom=/^[ \t]*defdelegate[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\1/d,delegates/
--regex-ElixirCustom=/^[ \t]*defrecord[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/r,records/
--regex-ElixirCustom=/^[ \t]*test[ \t]+"([^"]*)"/\1/t,tests/
--regex-ElixirCustom=/^[ \t]*@callback[ \t]+([a-zA-Z_][a-zA-Z0-9_?!]*)/\1/c,callbacks/
--regex-ElixirCustom=/^[ \t]*defoperator[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/o,operators/

--langdef=Jac
--langmap=Jac:.jac
--regex-Jac=/^[ \t]*(async[ \t]+)?(obj|class)(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\4/o,objects/
--regex-Jac=/^[ \t]*(async[ \t]+)?node(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/n,nodes/
--regex-Jac=/^[ \t]*(async[ \t]+)?edge(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/e,edges/
--regex-Jac=/^[ \t]*(async[ \t]+)?walker(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/w,walkers/
--regex-Jac=/^[ \t]*enum(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/g,enums/
--regex-Jac=/^[ \t]*((async|static|override|abstract|class)[ \t]+)*def(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\4/f,functions/
--regex-Jac=/^[ \t]*((async|static|override|abstract)[ \t]+)*can(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\4/a,abilities/
--regex-Jac=/^[ \t]*impl[ \t]+([a-zA-Z_][a-zA-Z0-9_.]*)/\1/i,implementations/
--regex-Jac=/^[ \t]*type(:[a-z]+)?[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/y,types/
--regex-Jac=/^[ \t]*test[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/t,tests/
--regex-Jac=/^[ \t]*test[ \t]+["']([^"']+)["']/\1/t,tests/
# Typed variables, parameters and has/glob fields, including comma continuations.
--mline-regex-Jac=/(^|[,;{(\n])[ \t]*(static[ \t]+)?((has|glob)(:[a-z]+)?[ \t]+|let[ \t]+)?([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*:[ \t]*[a-zA-Z_]/\6/v,variables/{mgroup=6}
# Inferred variables; exclude equality comparisons.
--mline-regex-Jac=/(^|[;{\n])[ \t]*((glob(:[a-z]+)?|let)[ \t]+)?([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*[^=]/\5/v,variables/{mgroup=5}
